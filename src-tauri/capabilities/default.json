{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs-pro:default",
    "fs-pro:allow-icon",
    "fs-pro:allow-get-default-save-icon-path",
    "fs-pro:allow-is-file",
    "fs-pro:allow-is-dir",
    "fs-pro:allow-extname",
    "fs-pro:allow-metadata",
    "fs-pro:allow-size",
    "fs:default",
    {
      "identifier": "fs:allow-app-read",
      "allow": [
        "$APPDATA/**",
        "$LOCALDATA/**"
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**",
        "$DESKTOP/**",
        "$DOWNLOAD/**",
        "$PICTURE/**",
        "$DOCUMENT/**",
        "$VIDEO/**",
        "$AUDIO/**",
        "$PUBLIC/**",
        "$TEMP/**"
      ]
    },
    "dialog:default"
  ]
}
