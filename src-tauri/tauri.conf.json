{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "xtools",
	"version": "0.1.0",
	"identifier": "com.tauri-app.xtools",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "XToolKit",
				"width": 1200,
				"height": 800,
				"dragDropEnabled": true,
				"decorations": false,
				"shadow": true
			}
		],
		"security": {
			"dangerousDisableAssetCspModification": ["style-src"],
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$HOME/**",
					"$DESKTOP/**",
					"$DOWNLOAD/**",
					"$VIDEO/**",
					"$AUDIO/**",
					"$PICTURE/**",
					"$DOCUMENT/**",
					"$PUBLIC/**",
					"$TEMP/**"
				]
			},
			"csp": {
				"default-src": ["'self'", "ipc:", "asset:", "http://asset.localhost"],
				"connect-src": ["ipc:", "http://ipc.localhost", "http://tauri.localhost"],
				"img-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
				"media-src": ["'self'", "asset:", "http://asset.localhost", "data:", "blob:"],
				"script-src": ["'self'", "'unsafe-inline'", "'wasm-unsafe-eval'"],
				"style-src": ["'self'", "'unsafe-inline'", "asset:", "https://at.alicdn.com"],
				"style-src-elem": ["'self'", "'unsafe-inline'", "asset:", "https://at.alicdn.com"],
				"font-src": ["'self'", "asset:", "data:", "https://at.alicdn.com"]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
