{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "xtools",
	"version": "0.1.0",
	"identifier": "com.tauri-app.xtools",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "XToolKit",
				"width": 1200,
				"height": 800,
				"dragDropEnabled": true,
				"decorations": false,
				"shadow": true
			}
		],
		"security": {
			"assetProtocol": {
				"enable": true,
				"scope": [
					"$HOME/**",
					"$DESKTOP/**",
					"$DOWNLOAD/**",
					"$VIDEO/**",
					"$AUDIO/**",
					"$PICTURE/**",
					"$DOCUMENT/**",
					"$PUBLIC/**",
					"$TEMP/**"
				]
			},
			"csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob: data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	}
}
